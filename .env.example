# Copy to .env (git-ignored). docker compose reads it automatically.
GATEWAY_ENVIRONMENT=development
# Required in production (>= 24 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_ADMIN_API_KEY=demo-admin-key-change-me-0000

# Real providers (optional; referenced by api_key_env in the policy file)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Alert delivery (optional)
SLACK_WEBHOOK_URL=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Fraction of requests traced (head sampling). 1.0 traces everything; lower it at high request rates.
GATEWAY_OTEL_SAMPLE_RATIO=0.1
